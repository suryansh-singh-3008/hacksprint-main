# Production database
# DATABASE_URL should be your pooled PostgreSQL connection string (recommended for Vercel).
DATABASE_URL=
# DIRECT_URL should be your direct PostgreSQL connection string for Prisma migrations.
DIRECT_URL=

# LLM providers (at least one is required; the app falls back between providers).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
